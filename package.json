{
  "name": "jaotan.ts",
  "version": "0.0.0",
  "description": "jao Gamers Club Official Discord Bot for TypeScript",
  "homepage": "https://github.com/jaoafa/jaotan.ts",
  "bugs": {
    "url": "https://github.com/jaoafa/jaotan.ts/issues"
  },
  "license": "MIT",
  "author": "jao Community",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:jaoafa/jaotan.ts.git"
  },
  "scripts": {
    "dev": "tsx watch ./src/main.ts",
    "lint:prettier": "prettier --check src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "start": "tsx ./src/main.ts",
    "lint:tsc": "tsc",
    "fix": "run-z fix:prettier fix:eslint",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "test": "jest --runInBand --passWithNoTests --detectOpenHandles --forceExit",
    "fix:prettier": "prettier --write src",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "generate-schema": "typescript-json-schema --esModuleInterop --required src/config.ts ConfigInterface -o schema/Configuration.json"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@book000/eslint-config": "1.16.118",
    "@book000/node-utils": "1.26.9",
    "@napi-rs/canvas": "1.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/node-cron": "3.0.11",
    "cheerio": "1.2.0",
    "discord.js": "14.28.1",
    "emoji-regex": "11.0.0",
    "eslint": "10.14.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "node-cron": "4.6.0",
    "prettier": "3.9.10",
    "run-z": "2.1.0",
    "sudachi-wasm333": "1.0.4",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-json-schema": "0.68.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ],
      "^.+\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.*/)?emoji-regex/)"
    ],
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ]
  }
}
